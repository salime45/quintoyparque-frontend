rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function basicText(value, maxLength) { return value is string && value.size() > 0 && value.size() <= maxLength; }

    match /places/{placeId} {
      allow read: if resource.data.status == "published" || admin();
      allow create, update, delete: if admin();

      match /reviews/{reviewId} {
        allow read: if resource.data.status == "published" || admin();
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/places/$(placeId))
          && get(/databases/$(database)/documents/places/$(placeId)).data.status == "published"
          && reviewId == request.auth.uid
          && request.resource.data.keys().hasOnly(["uid", "rating", "comment", "status", "createdAt"])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
          && basicText(request.resource.data.comment, 700)
          && request.resource.data.status == "pending"
          && request.resource.data.createdAt == request.time;
        allow update, delete: if admin();
      }
    }

    match /suggestions/{suggestionId} {
      allow read: if admin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["uid", "name", "address", "comment", "lat", "lng", "status", "createdAt"])
        && request.resource.data.uid == request.auth.uid
        && basicText(request.resource.data.name, 120)
        && basicText(request.resource.data.address, 250)
        && basicText(request.resource.data.comment, 700)
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.lat >= 38 && request.resource.data.lat <= 41
        && request.resource.data.lng >= -2 && request.resource.data.lng <= 1
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt == request.time;
      allow update, delete: if admin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
