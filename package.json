{
  "name": "quintoyparque-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Quinto y Parque web and Firestore security rules",
  "scripts": {
    "test": "node --test tests/*.test.mjs && vitest run",
    "test:firestore": "firebase emulators:exec --project demo-quintoyparque --only firestore \"node --test tests/firestore.rules.test.cjs\"",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test",
    "test:components": "vitest run",
    "catalog:plan": "node scripts/sync-firestore-catalog.mjs --region=all",
    "catalog:sync:test": "node scripts/sync-firestore-catalog.mjs --region=all --write",
    "build:geo": "node scripts/build-geo.mjs",
    "test:geo": "firebase emulators:exec --project demo-quintoyparque --only firestore \"node --test tests/firestore-catalog.integration.mjs && node tests/seed-geo-emulator.mjs && VITE_CATALOG_SOURCE=firestore VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8188 vite build && CATALOG_E2E=geo playwright test\"",
    "catalog:es:setup": "node scripts/national/setup.mjs",
    "catalog:es:download": "node scripts/national/download.mjs",
    "catalog:es:prepare": "node --max-old-space-size=3072 scripts/national/prepare.mjs",
    "catalog:es:report": "node scripts/national/cli.mjs",
    "catalog:es:import": "node scripts/national/cli.mjs --write",
    "test:osm": "node scripts/national/test-parser.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.5.1",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "15.33.0",
    "jsdom": "^26.1.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.7"
  },
  "type": "module",
  "dependencies": {
    "firebase": "12.19.0",
    "geofire-common": "^6.0.0",
    "leaflet": "1.9.4",
    "vue": "^3.5.0"
  }
}
